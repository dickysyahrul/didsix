---
// 1. Mengubah path impor (tambah satu tingkat ../ lagi karena file ada di dalam folder [locale])
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { t } from "../../i18n/ui";
import Hero from "../../components/Hero.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import CTA from "../../components/CTA.astro";

// 2. Wajib menambahkan getStaticPaths untuk rute dinamis Astro
export function getStaticPaths() {
  return [
    { params: { locale: "id" } }
  ];
}

// 3. Mengambil locale "id" dari URL, bukan lagi mengatur manual ke "en"
const { locale } = Astro.params;
const currentLocale = locale as "id";

const allPages: CollectionEntry<"pages">[] = await getCollection("pages");
const page = allPages.find(
  (p) => p.data.slug === "about" && p.data.locale === currentLocale,
);

interface PageSection {
  type: string;
  title?: string;
  content?: string;
  ctaText?: string;
  ctaHref?: string;
  items?: { title?: string; description?: string; icon?: string }[];
}

const sections: PageSection[] = page?.data.sections || [];
const heroSection = sections.find((s) => s.type === "hero");
const featuresSection = sections.find((s) => s.type === "features");
const ctaSection = sections.find((s) => s.type === "cta");
const featureItems = featuresSection?.items || [];
const featureColumns = featureItems.length % 2 === 0 ? 2 : 3;
---

<BaseLayout
  title={page?.data.title || t(currentLocale, "nav.about")}
  description={page?.data.description}
  locale={currentLocale}
  path={"/about"}
>
  {
    heroSection && (
      <Hero
        variant="centered"
        size="md"
        eyebrow="About"
        title={heroSection.title || page?.data.title || ""}
        content={heroSection.content}
        locale={currentLocale}
      />
    )
  }
  {
    featuresSection && (
      <FeatureGrid
        title={featuresSection.title}
        columns={featureColumns}
        features={featureItems.map((i) => ({
          title: i.title || "",
          description: i.description || "",
          icon: i.icon,
        }))}
      />
    )
  }
  {
    ctaSection && (
      <CTA
        title={ctaSection.title || ""}
        content={ctaSection.content}
        ctaText={ctaSection.ctaText}
        ctaHref={ctaSection.ctaHref}
        locale={currentLocale}
      />
    )
  }
</BaseLayout>
