---
// 1. Jalur impor disesuaikan dengan menambahkan ../
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Hero from "../../components/Hero.astro";
import FAQ from "../../components/FAQ.astro";
import CTA from "../../components/CTA.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  FeatureTabs,
  StackMarquee,
  Credibility,
  LighthouseScores,
} from "../../components/landing/index";
import { t } from "../../i18n/ui";

// 2. Mendaftarkan rute untuk bahasa Indonesia
export function getStaticPaths() {
  return [
    { params: { locale: "id" } }
  ];
}

const stackEntries = (await getCollection("stack"))
  .sort(
    (a: CollectionEntry<"stack">, b: CollectionEntry<"stack">) =>
      a.data.order - b.data.order,
  )
  .map((entry: CollectionEntry<"stack">) => entry.data);

// 3. Menangkap bahasa "id" dari URL
const locale = Astro.params.locale as "id";

// 4. Menerjemahkan konten tab ke bahasa Indonesia
const tabs = [
  {
    id: "performance",
    icon: "zap",
    heading: "Performa",
    description:
      "Struktur ringan yang mengutamakan statis, mengirimkan JavaScript seminimal mungkin dan dirender dari jaringan edge Cloudflare.",
    points: [
      "Render statis secara bawaan",
      "Arsitektur Zero-JS islands",
      "Pengiriman edge dengan cache pintar",
    ],
    visual: "$ npm run build\n✓ 25 pages built in 6.4s\n→ Deployed to the edge",
  },
  {
    id: "content",
    icon: "pen-line",
    heading: "Konten",
    description:
      "Menulis dalam Markdown dengan alur kerja berbasis Git. Blog, dokumen, dan layanan dipastikan aman secara tipe data (type-safe).",
    points: [
      "Koleksi Markdown yang type-safe",
      "Berversi dan ditinjau melalui Git",
      "Halaman blog, dokumen, dan layanan",
    ],
    visual:
      "src/content/\n├─ blog/\n├─ docs/\n├─ services/\n└─ pages/",
  },
  {
    id: "growth",
    icon: "trending-up",
    heading: "Pertumbuhan",
    description:
      "Semua yang dibutuhkan mesin pencari dan platform sosial akan dibuat secara otomatis pada setiap proses build.",
    points: [
      "Sitemap, RSS, dan robots.txt",
      "URL Kanonikal dan JSON-LD",
      "Gambar Open Graph yang dinamis",
    ],
    visual:
      "<meta property=\"og:image\" ... />\n<link rel=\"canonical\" ... />\n<script type=\"application/ld+json\">",
  },
];
---

<MarketingLayout
  title={t(locale, "nav.home")}
  description="Boilerplate untuk situs pemasaran yang cepat."
  locale={locale}
  path="/"
>
  <Hero
    variant="centered"
    eyebrow="Marketing Starter"
    headline={t(locale, "hero.title")}
    subheadline={t(locale, "hero.subtitle")}
    primaryCta={{ label: t(locale, "hero.cta"), href: "/id/services" }}
    secondaryCta={{ label: "Baca Blog", href: "/id/blog" }}
    locale={locale}
  />

  <section class="container py-16">
    <header class="section-head">
      <p class="section-head__eyebrow">Mengapa memilih struktur ini</p>
      <h2 class="section-head__title">Dibangun untuk performa dan skala besar</h2>
      <p class="section-head__lead">
        Semua yang Anda butuhkan untuk meluncurkan situs pemasaran yang cepat.
      </p>
    </header>
    <FeatureTabs client:visible tabs={tabs} />
  </section>

  <section class="container py-10">
    <header class="section-head">
      <h2 class="section-head__title">Didukung oleh teknologi modern</h2>
    </header>
    <StackMarquee items={stackEntries} />
  </section>

  <section class="container py-16">
    <Credibility
      stats={[
        { value: "55+", label: "Halaman" },
        { value: "100%", label: "Statis Bawaan" },
        { value: "A11y", label: "WCAG AA" },
      ]}
      logos={[
        { name: "Astro", src: undefined },
        { name: "Cloudflare", src: undefined },
        { name: "Tailwind", src: undefined },
      ]}
    />
  </section>

  <section class="container py-16">
    <header class="section-head">
      <h2 class="section-head__title">Skor Lighthouse Sempurna</h2>
      <p class="section-head__lead">
        Skor target, diverifikasi dengan Lighthouse — dioptimalkan langsung dari awal untuk performa, aksesibilitas, dan SEO.
      </p>
    </header>
    <LighthouseScores />
  </section>

  <FAQ
    title="Pertanyaan yang sering diajukan"
    items={[
      {
        question: "Apakah ini siap untuk multi-bahasa?",
        answer:
          "Ya. Mesin i18n sudah terhubung dan menggunakan bahasa Inggris sebagai bawaan, sehingga menambahkan bahasa baru hanya perlu memasukkan terjemahan dan konten.",
      },
      {
        question: "Apakah SEO sudah diatur secara otomatis?",
        answer:
          "Tag meta, URL kanonikal, sitemap, RSS, JSON-LD, dan gambar OG dinamis semuanya sudah terhubung secara default.",
      },
      {
        question: "Di mana situs ini di-deploy?",
        answer:
          "Ini dirancang untuk Cloudflare Pages dengan penyimpanan media R2 opsional, tetapi output statisnya bisa berjalan di hosting modern mana pun.",
      },
      {
        question: "Bagaimana cara mengelola konten?",
        answer:
          "Konten dikelola dalam koleksi Markdown (blog, docs, services, pages) yang berversi dan dapat ditinjau melalui Git.",
      },
    ]}
  />

  <CTA
    eyebrow="Mulai sekarang"
    title="Siap membangun situs Anda?"
    content="Jelajahi layanan kami atau pelajari dokumentasinya — semuanya siap digunakan."
    ctaText="Jelajahi layanan"
    ctaHref="/id/services"
    secondaryText="Baca dokumentasi"
    secondaryHref="/id/docs"
    locale={locale}
  />
</MarketingLayout>
