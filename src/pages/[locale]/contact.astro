---
// 1. TAMBAHKAN FUNGSI INI AGAR ASTRO TAHU URL APA YANG HARUS DIBUAT
export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "id" } },
  ];
}

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { t } from "../i18n/ui";
import { siteConfig } from "../config/site.config";
import Hero from "../components/Hero.astro";
import { Button, Icon } from "../components/ui/index";

// 2. Anda bisa mengambil locale dari params dynamic route, atau tetap gunakan currentLocale
const { locale } = Astro.params; 
// const locale = (Astro.currentLocale || "id") as "id"; // (Ini juga tetap bisa digunakan)

const allPages: CollectionEntry<"pages">[] = await getCollection("pages");
const page = allPages.find(
  (p) => p.data.slug === "contact" && p.data.locale === locale,
);

const allSettings = await getCollection("settings");
const settings = allSettings[0]?.data as
  | {
      mapLatitude?: string;
      mapLongitude?: string;
      orgName?: string;
      orgEmail?: string;
    }
  | undefined;

const lat = settings?.mapLatitude || "-6.2088";
const lng = settings?.mapLongitude || "106.8456";
const hasMap = Boolean(lat && lng);
const contactEmail = settings?.orgEmail || siteConfig.email;

// The interactive Google Maps embed is loaded on click (facade pattern) so its
// third-party JS never weighs on initial load (no TBT).
const mapEmbed = `https://maps.google.com/maps?q=${lat}%2C${lng}&z=15&hl=${locale}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${lat}%2C${lng}`;

interface PageSection {
  type: string;
  title?: string;
  content?: string;
  items?: { title?: string; description?: string; icon?: string }[];
}

const sections: PageSection[] = page?.data.sections || [];
const heroSection = sections.find((s) => s.type === "hero");
const featuresSection = sections.find((s) => s.type === "features");

const iconByTitle: Record<string, string> = {
  Email: "lucide:mail",
  Kantor: "lucide:map-pin",
  Office: "lucide:map-pin", // Berjaga-jaga jika fallback ke bahasa Inggris
  Sosial: "lucide:at-sign",
  Social: "lucide:at-sign",
  Telepon: "lucide:phone",
  Phone: "lucide:phone",
};

const methods = (featuresSection?.items || []).map((item) => ({
  title: item.title || "",
  description: item.description || "",
  icon: iconByTitle[item.title || ""] || "lucide:circle",
}));
---

<BaseLayout
  title={page?.data.title || t(locale as "en" | "id", "nav.contact")}
  description={page?.data.description}
  locale={locale as "en" | "id"}
  path={"/contact"}
>
<!-- SISA KODE HTML/KOMPONEN DI BAWAHNYA TETAP SAMA SEPERTI SEBELUMNYA -->
  {
    heroSection && (
      <Hero
        variant="centered"
        size="md"
        eyebrow="Kontak"
        headline={heroSection.title || page?.data.title || ""}
        subheadline={heroSection.content}
        locale={locale as "en" | "id"}
      />
    )
  }

  <section class="contact container">
    <div class="contact__grid">
      <div class="contact__intro">
        <h2>Kirim pesan kepada kami</h2>
        <p>
          Punya pertanyaan atau ingin bekerja sama? Kirim email langsung kepada kami dan kami akan membalasnya dalam satu hari kerja.
        </p>
        <Button href={`mailto:${contactEmail}`} variant="primary">
          Email {contactEmail}
        </Button>
<!-- ... SISA KODE ANDA ... -->
